<UserControl x:Class="DuoWall.App.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Search Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox Width="260"
                            PlaceholderText="Search wallpapers (space, sunset, cyberpunk...)"
                            Text="{Binding GallerySearchText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0" />
                <ComboBox Width="130"
                          ItemsSource="{Binding SortModes}"
                          SelectedItem="{Binding SelectedSortMode}"
                          Margin="0,0,10,0" />
                <ui:Button Appearance="Secondary" Command="{Binding LoadGalleryCommand}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                </ui:Button>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Wallpaper Gallery" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding GalleryStatusText}" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Category / Resolution Filter Chips -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding GalleryCategories}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding}"
                                 Style="{StaticResource PillRadioStyle}"
                                 GroupName="GalleryCategoryPills"
                                 Margin="0,0,6,6"
                                 Padding="12,5"
                                 FontSize="12"
                                 Command="{Binding DataContext.SelectCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 CommandParameter="{Binding}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource MultiEq}" Mode="OneWay">
                                <Binding />
                                <Binding Path="DataContext.SelectedGalleryCategory" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Active Filter Indicator -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Active Filter:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            <Border Background="#2563EB" CornerRadius="10" Padding="10,2" Margin="8,0,0,0">
                <TextBlock Text="{Binding SelectedGalleryCategory}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Gallery Thumbnail Grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" ScrollChanged="GalleryScroll_Changed">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding GalleryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="312" Margin="0,0,14,14" CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="Card_Click">
                                <StackPanel>
                                    <Grid Height="106" ClipToBounds="True">
                                        <Border CornerRadius="11,11,0,0" Background="#101521" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Favorite Star Button -->
                                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                   Padding="6" Appearance="Secondary"
                                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Star24" FontSize="14"
                                                           Filled="{Binding IsFavorite}" />
                                        </ui:Button>

                                        <!-- Downloaded / Club Badges -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                            <Border Background="#CC166534" CornerRadius="6" Padding="7,2" Margin="0,0,4,0"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Saved" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#CC92400E" CornerRadius="6" Padding="7,2"
                                                    Visibility="{Binding RequiresAuthentication, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Club / Auth" Foreground="#FEF3C7" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="12,10">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AspectRatioLabel}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                                            <TextBlock Text="{Binding TagsSummary}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,0,0,10"
                                 Visibility="{Binding IsLoadingGallery, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Secondary" Click="LoadMore_Click"
                               Visibility="{Binding HasMoreGalleryItems, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Load More Wallpapers" Padding="14,2" />
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
