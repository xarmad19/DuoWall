<UserControl x:Class="DuoWall.App.Views.TaskbarTweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
        <StackPanel MaxWidth="1040">
            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Command="{Binding ApplyMacOsGlassDockPresetCommand}" Margin="0,0,8,0">
                        <TextBlock Text="Quick Preset: macOS Glass Dock" FontWeight="SemiBold" />
                    </ui:Button>
                    <ui:Button Appearance="Danger" Command="{Binding RestoreDefaultTaskbarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUndo24" Margin="0,0,6,0" />
                            <TextBlock Text="Restore Default Taskbar" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Taskbar Tweaks" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Match your Windows taskbar to DuoWall's global Glass theme, center icons as a floating dock, or choose per-display visibility"
                               FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Surface & Glass Theme Integration (4a, 4b) -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="#2638BDF8" BorderBrush="#6038BDF8" BorderThickness="1" CornerRadius="7" Padding="10,3">
                            <TextBlock Text="{Binding ActiveGlassSummary, StringFormat='Linked Widget Theme: {0}'}" FontSize="11.5" Foreground="#93C5FD" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="TASKBAR GLASS &amp; TRANSPARENCY (4a &amp; 4b)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <CheckBox Content="Apply Universal Widget Glass Theme (Acrylic Tint &amp; Blur) to Windows Taskbar"
                              IsChecked="{Binding EnableTaskbarGlass}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <StackPanel Margin="26,0,0,12">
                        <DockPanel Margin="0,0,0,4" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TaskbarAcrylicOpacity, StringFormat='{}{0:P0}'}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock Text="Taskbar Glass Opacity / Tint Strength" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <Slider Minimum="0.05" Maximum="0.95" TickFrequency="0.05" MaxWidth="420" HorizontalAlignment="Left"
                                Value="{Binding TaskbarAcrylicOpacity}" />
                    </StackPanel>

                    <CheckBox Content="Make Windows Taskbar Completely Invisible / Transparent (Floating Icons Only)"
                              IsChecked="{Binding MakeTaskbarInvisible}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Note: Invisible taskbar removes the solid bar strip cleanly while keeping Start button, system tray, and notifications clickable."
                               FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="26,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Centered Icons & Floating Glass Dock (4c) -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="CENTERED ICONS &amp; FLOATING GLASS DOCK (4c)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="Center Taskbar App Icons Horizontally (macOS Dock Style)"
                              IsChecked="{Binding CenterTaskbarIcons}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <CheckBox Content="Enable Floating Glass Dock Background Behind Centered Icons (Uses Widget Glass Theme &amp; Corner Radius)"
                              IsChecked="{Binding EnableTaskbarGlassDock}" FontSize="13.5" FontWeight="SemiBold" Margin="24,0,0,6" />
                    <TextBlock Text="Adapts dynamically as windows open/close and matches your exact Glassmorphism corner radius, blur intensity, and border glow."
                               FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="50,0,0,12" />

                    <Grid Margin="24,0,0,0" MaxWidth="680" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" /><ColumnDefinition Width="24" /><ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TaskbarDockExtraWidthPx, StringFormat='{}{0:+#;-#;0} px'}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Dock Bar Extra Width" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <Slider Minimum="-16" Maximum="240" TickFrequency="4" Value="{Binding TaskbarDockExtraWidthPx}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TaskbarDockHeightPx, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Dock Bar Height" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <Slider Minimum="26" Maximum="76" TickFrequency="1" Value="{Binding TaskbarDockHeightPx}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Multi-Monitor Display Target & Behavior (4d, 4e) -->
            <Border Style="{StaticResource DuoCardStyle}">
                <StackPanel>
                    <TextBlock Text="MULTI-DISPLAY TASKBAR VISIBILITY &amp; BEHAVIOR (4d &amp; 4e)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10" />

                    <TextBlock Text="Show Windows Taskbar On:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,14">
                        <RadioButton Content="Both / All Displays (Default)" Style="{StaticResource PillRadioStyle}" GroupName="TbDisplay"
                                     IsChecked="{Binding TaskbarDisplayTarget, Converter={StaticResource EnumEq}, ConverterParameter=Both}" />
                        <RadioButton Content="Primary Display Only" Style="{StaticResource PillRadioStyle}" GroupName="TbDisplay"
                                     IsChecked="{Binding TaskbarDisplayTarget, Converter={StaticResource EnumEq}, ConverterParameter=PrimaryOnly}" />
                        <RadioButton Content="Secondary Display Only" Style="{StaticResource PillRadioStyle}" GroupName="TbDisplay"
                                     IsChecked="{Binding TaskbarDisplayTarget, Converter={StaticResource EnumEq}, ConverterParameter=SecondaryOnly}" />
                    </WrapPanel>

                    <CheckBox Content="Auto-Hide Windows Taskbar Until Cursor Moves to Screen Edge"
                              IsChecked="{Binding AutoHideTaskbar}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="Safety note: Secondary Display Only automatically keeps your main taskbar visible if only one display is connected, and all hidden taskbars restore automatically when DuoWall closes."
                               FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

