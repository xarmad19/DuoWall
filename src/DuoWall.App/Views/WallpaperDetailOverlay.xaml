<UserControl x:Class="DuoWall.App.Views.WallpaperDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DuoWall.App.Controls">
    <Grid Background="#BB000000">
        <Border MaxWidth="980" MaxHeight="760" Margin="32"
                Style="{StaticResource DuoCardStyle}"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding CloseDetailCommand}" Padding="8">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </ui:Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <ToggleButton Content="Preview on My Monitors"
                                      IsChecked="{Binding DetailShowMultiMonitorPreview}"
                                      Padding="12,6" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDetailWallpaper.Title}" FontSize="20" FontWeight="Bold" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                            <Run Text="{Binding SelectedDetailWallpaper.ResolutionLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SelectedDetailWallpaper.AspectRatioLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SelectedDetailWallpaper.SourceProvider, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- High-Res Preview or Multi-Monitor Preview -->
                <Grid Grid.Row="1" MinHeight="280" Margin="0,0,0,14">
                    <Border CornerRadius="10" Background="#0D1017" ClipToBounds="True"
                            Visibility="{Binding DetailShowMultiMonitorPreview, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Image Source="{Binding SelectedDetailWallpaper.PreviewBitmap}" Stretch="Uniform" />
                    </Border>

                    <controls:MultiMonitorPreviewControl Plan="{Binding DetailPreviewPlan}"
                                                         PreviewImageSource="{Binding SelectedDetailWallpaper.BestPreviewSource}"
                                                         BackgroundColorHex="{Binding BackgroundColorHex}"
                                                         ShowMonitorLabels="True"
                                                         DiskCacheDirectory="{Binding Settings.ThumbnailCacheDirectory}"
                                                         IsInteractive="False"
                                                         Visibility="{Binding DetailShowMultiMonitorPreview, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Description, Tags & Auth Warning -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <ui:InfoBar Title="Authentication / Membership Required"
                                Severity="Warning"
                                Message="{Binding SelectedDetailWallpaper.AccessRestrictionReason}"
                                IsOpen="{Binding SelectedDetailWallpaper.RequiresAuthentication, FallbackValue=False}"
                                Visibility="{Binding SelectedDetailWallpaper.RequiresAuthentication, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}"
                                IsClosable="False"
                                Margin="0,0,0,10" />

                    <TextBlock Text="{Binding SelectedDetailWallpaper.Description}" TextWrapping="Wrap" MaxHeight="62"
                               TextTrimming="CharacterEllipsis" FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding SelectedDetailWallpaper.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="10" Padding="10,3" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Action Buttons -->
                <DockPanel Grid.Row="3">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Margin="0,0,8,0"
                                   Command="{Binding OpenSourcePageCommand}"
                                   CommandParameter="{Binding SelectedDetailWallpaper}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Open Source Page" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary" Margin="0,0,8,0"
                                   Command="{Binding DownloadOnlyCommand}"
                                   CommandParameter="{Binding SelectedDetailWallpaper}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Download Original" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary" Margin="0,0,8,0"
                                   Command="{Binding SendToStudioCommand}"
                                   CommandParameter="{Binding SelectedDetailWallpaper}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Crop24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Adjust in Studio" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Primary"
                                   Command="{Binding QuickApplyWallpaperCommand}"
                                   CommandParameter="{Binding SelectedDetailWallpaper}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Apply to Monitors" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <ui:Button Appearance="Secondary"
                               Command="{Binding ToggleFavoriteCommand}"
                               CommandParameter="{Binding SelectedDetailWallpaper}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="15" Filled="{Binding SelectedDetailWallpaper.IsFavorite}" Margin="0,0,6,0" />
                            <TextBlock Text="Favorite" />
                        </StackPanel>
                    </ui:Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
