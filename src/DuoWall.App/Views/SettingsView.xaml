<UserControl x:Class="DuoWall.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:DuoWall.Core.Models;assembly=DuoWall.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Configure theme, Windows startup, automatic display detection, downloads, and cache"
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,18" />

            <!-- Appearance & Automation -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="APPEARANCE &amp; AUTOMATION" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsDarkTheme}" />
                        <StackPanel>
                            <TextBlock Text="Dark Theme (Fluent)" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Toggle between Windows 11 Dark (default) and Light themes" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoApplyOnStartup}" />
                        <StackPanel>
                            <TextBlock Text="Reapply Wallpaper When Windows Starts" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Registers DuoWall in user startup to preserve seamless multi-monitor framing across reboots" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoReapplyOnDisplayChange}" />
                        <StackPanel>
                            <TextBlock Text="Automatic Display Change Recovery" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically recomposes wallpapers when monitors connect, disconnect, or change resolution" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Wallpaper Quality & Defaults -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ENGINE DEFAULTS &amp; QUALITY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Coordinate Geometry" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding CoordinateSpaces}" SelectedItem="{Binding CoordinateSpace}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Generated Monitor Output Format" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox SelectedValue="{Binding OutputFormat}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="PNG Lossless (Recommended)" Tag="{x:Static models:OutputImageFormat.PngLossless}" />
                                <ComboBoxItem Content="JPEG High Quality (96%)" Tag="{x:Static models:OutputImageFormat.JpegHighQuality}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Download Location & Cache -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="STORAGE &amp; CACHE MANAGEMENT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Wallpaper Download Directory (Originals are never overwritten)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding OpenDownloadDirectoryCommand}" Margin="8,0,0,0">
                            <TextBlock Text="Open" />
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Command="{Binding BrowseDownloadDirectoryCommand}" Margin="8,0,0,0">
                            <TextBlock Text="Browse..." />
                        </ui:Button>
                        <ui:TextBox Text="{Binding DownloadDirectory}" IsReadOnly="True" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding ClearCachesCommand}">
                            <TextBlock Text="Clear Thumbnail Cache" />
                        </ui:Button>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="Thumbnail Cache: " />
                                <Run Text="{Binding ThumbnailCacheSizeText, Mode=OneWay}" />
                                <Run Text="  ·  Generated Monitor Slices: " />
                                <Run Text="{Binding GeneratedCacheSizeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding MaxThumbnailCacheMb, StringFormat='Max Thumbnail Cache Size: {0} MB'}"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Slider Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                            Value="{Binding MaxThumbnailCacheMb}" />
                </StackPanel>
            </Border>

            <!-- Restore Defaults & About -->
            <Border Style="{StaticResource DuoCardStyle}">
                <StackPanel>
                    <TextBlock Text="RESTORE &amp; APPLICATION" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary"
                                   Command="{Binding RestorePreviousWallpaperCommand}"
                                   IsEnabled="{Binding HasWindowsBackup}">
                            <TextBlock Text="Restore Previous Wallpaper" />
                        </ui:Button>
                        <StackPanel>
                            <TextBlock Text="Restore Previous Windows Wallpaper" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Reverts desktop backgrounds to the state captured before DuoWall applied changes" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding CheckForUpdatesCommand}">
                            <TextBlock Text="Check Updates" />
                        </ui:Button>
                        <StackPanel>
                            <TextBlock Text="DuoWall by SRMD · Version 1.0.0" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Native .NET 8 WPF multi-monitor wallpaper compositor · Gallery powered by UltraWideWallpapers.net"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
