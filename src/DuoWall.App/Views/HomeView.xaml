<UserControl x:Class="DuoWall.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DuoWall.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
        <StackPanel>
            <!-- Page Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RestorePreviousWallpaperCommand}"
                               IsEnabled="{Binding HasWindowsBackup}"
                               Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" Margin="0,0,6,0" />
                            <TextBlock Text="Restore Previous" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Command="{Binding ApplyWallpaperCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Apply Wallpaper" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding CombinedGeometrySummary}" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Hero Multi-Monitor Live Preview Card -->
            <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,18" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="290" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Click="OpenStudio_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Crop24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Customize in Studio" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Click="OpenGallery_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Browse Gallery" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="#60A5FA" Margin="0,0,8,0" />
                            <TextBlock Text="Live Multi-Monitor Preview" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="  (drag inside preview to pan · scroll to zoom)" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <controls:MultiMonitorPreviewControl x:Name="HomePreview"
                                                         Grid.Row="1"
                                                         Plan="{Binding CurrentPlan}"
                                                         PreviewImageSource="{Binding StagedPreviewSource}"
                                                         BackgroundColorHex="{Binding BackgroundColorHex}"
                                                         ShowMonitorLabels="{Binding ShowMonitorLabels}"
                                                         DiskCacheDirectory="{Binding Settings.ThumbnailCacheDirectory}"
                                                         IsInteractive="True" />

                    <DockPanel Grid.Row="2" Margin="4,10,4,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding StagedWallpaper.ResolutionLabel, FallbackValue='—'}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StagedWallpaper.Title, FallbackValue='Select a wallpaper from Gallery or import a local image'}"
                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Summary Metrics Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CONNECTED MONITORS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Monitors.Count, StringFormat='{}{0} Active Displays'}"
                                   FontSize="20" FontWeight="Bold" Margin="0,6,0,8" />
                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding ResolutionLabel}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DuoCardStyle}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT ENGINE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding PlacementMode}" FontSize="20" FontWeight="Bold" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding CoordinateSpace, StringFormat='Geometry: {0}'}"
                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Zoom, StringFormat='Zoom: {0:0.00}×'}"
                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DuoCardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CURRENT DESKTOP WALLPAPER" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding ActiveAppliedWallpaper.Title, FallbackValue='Not applied yet'}"
                                   FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding ActiveAppliedWallpaper.SourceProvider, FallbackValue='Browse UltraWideWallpapers.net or My Wallpapers'}"
                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recently Used Wallpapers -->
            <Border Style="{StaticResource DuoCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Click="OpenLibrary_Click">
                            <TextBlock Text="View All in Library →" FontSize="12.5" />
                        </ui:Button>
                        <TextBlock Text="Recently Used Wallpapers" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Wallpapers you apply will appear here for instant offline switching."
                               FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding RecentWallpapers.Count, Converter={StaticResource ZeroToVis}}" />

                    <ItemsControl ItemsSource="{Binding RecentWallpapers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Margin="0,0,12,12" CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="RecentCard_Click">
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#111520">
                                            <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                        </Border>
                                        <DockPanel Margin="10,8">
                                            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="8,4"
                                                       Command="{Binding DataContext.QuickApplyWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Text="Apply" FontSize="11" />
                                            </ui:Button>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ResolutionLabel}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
