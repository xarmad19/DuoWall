<UserControl x:Class="DuoWall.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox Width="240"
                            PlaceholderText="Search local wallpapers..."
                            Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0" />
                <ui:Button Appearance="Primary" Command="{Binding ImportLocalImageCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="15" Margin="0,0,6,0" />
                        <TextBlock Text="Import Local Image" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Command="{Binding OpenDownloadDirectoryCommand}">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" />
                </ui:Button>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="My Wallpapers" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Downloaded originals, favorites, recently applied, and local imports" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Library Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Content="All Downloaded" Style="{StaticResource PillRadioStyle}" GroupName="LibTab"
                         IsChecked="{Binding SelectedLibraryTab, Converter={StaticResource EnumEq}, ConverterParameter='All Downloaded'}"
                         Click="Tab_Click" Tag="All Downloaded" />
            <RadioButton Content="Favorites" Style="{StaticResource PillRadioStyle}" GroupName="LibTab"
                         IsChecked="{Binding SelectedLibraryTab, Converter={StaticResource EnumEq}, ConverterParameter='Favorites'}"
                         Click="Tab_Click" Tag="Favorites" />
            <RadioButton Content="Recently Used" Style="{StaticResource PillRadioStyle}" GroupName="LibTab"
                         IsChecked="{Binding SelectedLibraryTab, Converter={StaticResource EnumEq}, ConverterParameter='Recently Used'}"
                         Click="Tab_Click" Tag="Recently Used" />
        </StackPanel>

        <!-- Library Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource DuoCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding LibraryItems.Count, Converter={StaticResource ZeroToVis}}">
                    <StackPanel HorizontalAlignment="Center" Margin="20">
                        <ui:SymbolIcon Symbol="Image24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No wallpapers in this section yet" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,4" HorizontalAlignment="Center" />
                        <TextBlock Text="Download wallpapers from the Gallery or click Import Local Image." FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding LibraryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320" Margin="0,0,14,14" CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Border Height="110" CornerRadius="11,11,0,0" Background="#101521" ClipToBounds="True"
                                            Cursor="Hand" MouseLeftButtonUp="Card_Click">
                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Margin="12,10">
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="5"
                                                       Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Star24" FontSize="14" Filled="{Binding IsFavorite}" />
                                            </ui:Button>
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8">
                                            <Run Text="{Binding ResolutionLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding FileSizeLabel, Mode=OneWay}" />
                                        </TextBlock>

                                        <WrapPanel>
                                            <ui:Button Appearance="Primary" Padding="10,5" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.QuickApplyWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Text="Apply" FontSize="11.5" FontWeight="SemiBold" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.SendToStudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Text="Studio" FontSize="11.5" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="8,5" Margin="0,0,4,6" ToolTip="Open Source Webpage"
                                                       Command="{Binding DataContext.OpenSourcePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding SourcePageUrl, Converter={StaticResource StrToVis}}">
                                                <ui:SymbolIcon Symbol="Globe24" FontSize="13" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="8,5" Margin="0,0,4,6" ToolTip="Show File in Explorer"
                                                       Command="{Binding DataContext.OpenLocalFileInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="8,5" Margin="0,0,0,6" ToolTip="Delete from Library"
                                                       Command="{Binding DataContext.DeleteFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                            </ui:Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
