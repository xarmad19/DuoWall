<Window x:Class="DuoWall.App.Windows.CalendarEntryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Event / Reminder / Note"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStyle="ToolWindow">
    <Border Padding="18" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="DateHeaderText" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock x:Name="HolidaySubText" FontSize="12" Foreground="#FBBF24" Margin="0,2,0,10" Visibility="Collapsed" />

            <!-- Existing Entries on Selected Date -->
            <TextBlock x:Name="ExistingLabel" Text="SCHEDULED ON THIS DATE" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="#94A3B8" Margin="0,4,0,6" />
            <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel x:Name="ExistingEntriesHost" />
            </ScrollViewer>

            <!-- New Entry Composer -->
            <Border Background="#1E293B" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ADD TO CALENDAR" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="KindEventRadio" Content="Event" IsChecked="True" Margin="0,0,14,0" Foreground="#F8FAFC"
                                     Checked="KindRadio_Changed" />
                        <RadioButton x:Name="KindReminderRadio" Content="Reminder" Margin="0,0,14,0" Foreground="#F8FAFC"
                                     Checked="KindRadio_Changed" />
                        <RadioButton x:Name="KindNoteRadio" Content="Note" Foreground="#F8FAFC"
                                     Checked="KindRadio_Changed" />
                    </StackPanel>

                    <TextBlock Text="Title" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4" />
                    <TextBox x:Name="TitleBox" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"
                             Padding="8,6" FontSize="12.5" Margin="0,0,0,8" />

                    <TextBlock Text="Notes (optional)" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4" />
                    <TextBox x:Name="NotesBox" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"
                             Padding="8,6" FontSize="12" Margin="0,0,0,10" />

                    <StackPanel x:Name="TimeSettingsPanel">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Time (HH:mm 24h)" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="TimeBox" Text="09:00" Background="#0F172A" Foreground="#F8FAFC"
                                         BorderBrush="#475569" Padding="8,6" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duration (minutes)" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="DurationBox" Text="30" Background="#0F172A" Foreground="#F8FAFC"
                                         BorderBrush="#475569" Padding="8,6" FontSize="12.5" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="When Scheduled Time Reaches:" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4" />
                        <RadioButton x:Name="SilentAlertRadio" Content="Show silent desktop reminder popup"
                                     IsChecked="True" Foreground="#E2E8F0" Margin="0,0,0,4" />
                        <RadioButton x:Name="SoundAlertRadio" Content="Play alert sound until I dismiss it"
                                     Foreground="#FDE68A" Margin="0,0,0,6" />
                    </StackPanel>

                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Save Entry" Padding="16,7" FontWeight="SemiBold"
                                Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="SaveButton_Click" />
                        <Button DockPanel.Dock="Right" Content="Close" Padding="14,7" Margin="0,0,8,0"
                                Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand"
                                Click="CloseButton_Click" />
                        <TextBlock x:Name="ValidationText" Foreground="#FCA5A5" FontSize="11.5" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

