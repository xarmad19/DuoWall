<Window x:Class="DuoWall.App.Windows.PanoramicVideoBackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Black"
        Topmost="False">
    <Grid x:Name="RootGrid" Background="#0D1017">
        <!-- Single hardware-decoded MediaElement (kept rendered behind opaque fill so VisualBrush samples frames smoothly) -->
        <MediaElement x:Name="VideoPlayer"
                      Width="1920"
                      Height="1080"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Fill"
                      IsMuted="True"
                      ScrubbingEnabled="True"
                      MediaOpened="VideoPlayer_OnMediaOpened"
                      MediaEnded="VideoPlayer_OnMediaEnded"
                      MediaFailed="VideoPlayer_OnMediaFailed" />

        <!-- Gap-fill background color selected in Placement Studio -->
        <Border x:Name="GapBackgroundLayer" Background="#0D1017" />

        <!-- Per-monitor clipped VisualBrush projection matching Placement Studio geometry -->
        <Canvas x:Name="MonitorSliceCanvas" ClipToBounds="True" />
    </Grid>
</Window>
