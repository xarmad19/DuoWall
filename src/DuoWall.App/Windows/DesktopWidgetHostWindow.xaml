<Window x:Class="DuoWall.App.Windows.DesktopWidgetHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DuoWall.App.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        Topmost="False"
        PreviewMouseLeftButtonDown="OnPreviewMouseDown">

    <!-- 18px transparent shadow margin allows smooth anti-aliased rounded borders & soft shadows with zero rectangular edge clipping -->
    <Grid Margin="18">
        <controls:WidgetContentControl x:Name="WidgetContent" />

        <!-- Edit Mode overlay indicator & bottom-right resize thumb -->
        <Border x:Name="EditChromeBorder"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                BorderBrush="#60A5FA"
                BorderThickness="1.5"
                CornerRadius="12">
            <Border Background="#DD0F172A"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="8,3"
                    CornerRadius="6">
                <TextBlock x:Name="EditBadgeText"
                           Text="Unlocked · Drag to move"
                           Foreground="#E2E8F0"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
            </Border>
        </Border>

        <Thumb x:Name="ResizeThumb"
               Visibility="Collapsed"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,4,4"
               Cursor="SizeNWSE"
               DragDelta="ResizeThumb_OnDragDelta"
               DragCompleted="ResizeThumb_OnDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#DD1E293B"
                            BorderBrush="#60A5FA"
                            BorderThickness="1.2"
                            CornerRadius="5">
                        <TextBlock Text="◢"
                                   Foreground="#93C5FD"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
