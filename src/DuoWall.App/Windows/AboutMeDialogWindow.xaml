<Window x:Class="DuoWall.App.Windows.AboutMeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DuoWall by SRMD"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Padding="28,24" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header with Icon and Title -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/Assets/duowall.ico"
                       Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DuoWall" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text=" by SRMD" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,8,0" />
                        <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v2.0.0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Ultimate Multi-Monitor Panoramic Wallpaper &amp; Glass Widget Suite"
                               FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,18" />

            <!-- Verbatim About Me Card -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="ABOUT THE DEVELOPER" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                    <TextBlock Text="This software is developed by Syed Sarmad Iftikhar. You can give your feedback and request new features at engr.sarmad.iftikhar@gmail.com"
                               FontSize="13" LineHeight="20" Foreground="#F1F5F9" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Features Highlights -->
            <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="• Multi-Monitor Geometry Calibration" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                        <TextBlock Text="• True Glassmorphism Desktop Widgets" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                        <TextBlock Text="• Direct Canvas Transform &amp; Resizing" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="• Windows Taskbar Center Glass Dock" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                        <TextBlock Text="• Live Calendar, Weather &amp; App Shortcuts" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                        <TextBlock Text="• Built on .NET 8 &amp; SkiaSharp" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="36" Background="#0284C7" Foreground="#FFFFFF"
                        BorderThickness="0" Cursor="Hand" Click="SendFeedback_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✉  Email Feedback" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Height="36" Background="#334155" Foreground="#F8FAFC"
                        BorderThickness="0" Cursor="Hand" Click="OpenGitHub_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="GitHub Repository" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Height="36" Width="80" Background="#1E293B" Foreground="#94A3B8"
                        BorderBrush="#475569" BorderThickness="1" Cursor="Hand" Click="CloseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Close" FontSize="12" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
