<Window x:Class="DuoWall.App.Windows.InstalledAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Installed App"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStyle="ToolWindow">
    <Border Padding="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Installed Windows Apps" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="Pick any installed desktop or Windows Store application to add as a shortcut icon."
                           FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Row="1"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569"
                     Padding="10,7" FontSize="12.5" Margin="0,0,0,10"
                     TextChanged="SearchBox_TextChanged" />

            <Grid Grid.Row="2">
                <ListBox x:Name="AppsListBox"
                         Background="#111827" BorderBrush="#334155" BorderThickness="1"
                         SelectionChanged="AppsListBox_SelectionChanged"
                         MouseDoubleClick="AppsListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LaunchTarget}" FontSize="10.5" Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SourceKind}" FontSize="10" Foreground="#93C5FD" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="LoadingText" Text="Scanning installed Windows applications..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="#94A3B8" />
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <Button x:Name="BrowseManualBtn" Content="Browse .exe / .lnk..." DockPanel.Dock="Left"
                        Padding="10,6" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#475569"
                        Click="BrowseManualBtn_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0"
                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569"
                            Click="CancelBtn_Click" IsCancel="True" />
                    <Button x:Name="AddAppBtn" Content="Add App" Padding="16,6" IsEnabled="False"
                            Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#38BDF8" FontWeight="SemiBold"
                            Click="AddAppBtn_Click" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>

