<ui:FluentWindow x:Class="DuoWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:DuoWall.App.Views"
        Title="DuoWall by SRMD"
        Width="1360"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="DuoWall by SRMD" Padding="14,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/duowall.ico" Width="20" Height="20" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Foreground="#60A5FA" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MonitorSummaryHeader}" FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Top Action Menu Buttons -->
                    <ui:Button Appearance="Transparent"
                               Padding="10,4"
                               Margin="0,0,6,0"
                               Command="{Binding CheckForUpdatesCommand}"
                               ToolTip="Check GitHub for newer versions of DuoWall">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="#38BDF8" Margin="0,0,6,0" />
                            <TextBlock Text="Check for Updates" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="10,4"
                               Margin="0,0,6,0"
                               Command="{Binding ShowAboutMeCommand}"
                               ToolTip="About DuoWall &amp; Developer Contact">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person24" FontSize="13" Foreground="#A78BFA" Margin="0,0,6,0" />
                            <TextBlock Text="About Me" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0"
                    Padding="6,14">
                <DockPanel LastChildFill="True">
                    <!-- Bottom Quick Apply Card -->
                    <Border DockPanel.Dock="Bottom"
                            Margin="8,8,8,6"
                            Padding="12"
                            CornerRadius="10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Active Staging" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding StagedWallpaper.Title, FallbackValue='No wallpaper staged'}"
                                       FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,8" />
                            <ui:Button Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding ApplyWallpaperCommand}"
                                       IsEnabled="{Binding IsApplying, Converter={StaticResource InvBool}}"
                                       Padding="10,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Apply Wallpaper" FontWeight="SemiBold" FontSize="12.5" />
                                </StackPanel>
                            </ui:Button>
                            <ProgressBar Value="{Binding ApplyProgress}" Maximum="1.0" Height="3"
                                         Margin="0,8,0,0"
                                         Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ApplyProgressMessage}" FontSize="10.5"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WORKSPACE" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="16,4,0,6" />

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=0}"
                                     Click="NavButton_Click" Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=1}"
                                     Click="NavButton_Click" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Wallpaper Gallery" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=2}"
                                     Click="NavButton_Click" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Crop24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Placement Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=3}"
                                     Click="NavButton_Click" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="My Wallpapers" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=6}"
                                     Click="NavButton_Click" Tag="6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Widget Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=7}"
                                     Click="NavButton_Click" Tag="7">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color20" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Desktop Profiles" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=9}"
                                     Click="NavButton_Click" Tag="9">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Window24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Taskbar Tweaks" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="16,18,0,6" />

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=4}"
                                     Click="NavButton_Click" Tag="4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Monitor Setup" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRailRadioStyle}"
                                     IsChecked="{Binding CurrentPageIndex, Converter={StaticResource EnumEq}, ConverterParameter=5}"
                                     Click="NavButton_Click" Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Global Status / Error Banner -->
                    <Border Grid.Row="0" Margin="20,12,20,0"
                            Visibility="{Binding HasStatusBanner, Converter={StaticResource BoolToVis}}">
                        <ui:InfoBar Title="DuoWall Status"
                                    Message="{Binding StatusBannerMessage}"
                                    Severity="{Binding IsStatusError, Converter={StaticResource BoolToSeverity}}"
                                    IsOpen="{Binding HasStatusBanner, Mode=TwoWay}"
                                    IsClosable="True" />
                    </Border>

                    <!-- Active View Switcher -->
                    <Grid Grid.Row="1">
                        <views:HomeView x:Name="ViewHome" Visibility="Collapsed" />
                        <views:GalleryView x:Name="ViewGallery" Visibility="Collapsed" />
                        <views:StudioView x:Name="ViewStudio" Visibility="Collapsed" />
                        <views:LibraryView x:Name="ViewLibrary" Visibility="Collapsed" />
                        <views:MonitorsView x:Name="ViewMonitors" Visibility="Collapsed" />
                        <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed" />
                        <views:WidgetStudioView x:Name="ViewWidgetStudio" DataContext="{Binding WidgetStudio}" Visibility="Collapsed" />
                        <views:ProfilesView x:Name="ViewProfiles" DataContext="{Binding Profiles}" Visibility="Collapsed" />
                        <views:TaskbarTweaksView x:Name="ViewTaskbarTweaks" DataContext="{Binding TaskbarTweaks}" Visibility="Collapsed" />
                    </Grid>

                    <!-- Wallpaper Detail Modal Overlay -->
                    <views:WallpaperDetailOverlay Grid.Row="0" Grid.RowSpan="2"
                                                  Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
