# Optional local configuration examples for DuoWall by SRMD
# Copy to .env (ignored by Git) or configure inside Settings -> Weather & Updates.
# NEVER commit real API keys or personal tokens.

# Optional custom OpenWeatherMap API key (keyless Open-Meteo is used by default)
DUOWALL_WEATHER_API_KEY=

# Optional GitHub repository slug used for official release update notifications
DUOWALL_GITHUB_REPO=xarmad19/DuoWall

